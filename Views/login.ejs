<!DOCTYPE html>
<html lang="pt-BR">

<head>
    <meta charset="UTF-8">
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>Login - The Office Papelaria</title>

    <!-- Google Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">

    <!-- Bootstrap Icons -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">

    <!-- Estilos -->
    <link rel="stylesheet" href="/CSS/estilos.pt.css">
    <link rel="stylesheet" href="/CSS/login.pt.css">
</head>

<body>

    <!-- HEADER / NAVBAR -->
    <header>
        <div class="container">
            <div class="logo">
                <a href="/">
                    <img src="/IMG/Landing/logo.png" alt="The Office Papelaria">
                </a>
            </div>

            <nav>
                <ul>
                    <li><a href="/">Início</a></li>
                    <li><a href="/#sobre">Sobre nós</a></li>
                    <li><a href="/catalogo">Produtos</a></li>
                </ul>
            </nav>

            <div class="header-icons">
                <span class="user-category-label">Categoria de usuário</span>

                <a href="/catalogo" title="Buscar produtos">
                    <i class="bi bi-search"></i>
                </a>

                <a href="/login" title="Acessar conta" class="active">
                    <i class="bi bi-person-fill"></i>
                </a>

                <a href="/carrinho" title="Carrinho">
                    <i class="bi bi-cart-fill"></i>
                </a>
            </div>
        </div>
    </header>

    <!-- SEÇÃO PRINCIPAL DE LOGIN -->
    <main class="login-container">
        <div class="container login-wrapper">

            <!-- CARTÃO DE FORMULÁRIO -->
            <div class="auth-card">
                <h2>Bem-vindo(a) de volta!</h2>
                <p class="subtitle">Faça seu login para continuar</p>

                <% if (typeof erro !== 'undefined' && erro) { %>
                    <div class="alert-error">
                        <i class="bi bi-exclamation-triangle-fill"></i> <%= erro %>
                    </div>
                <% } %>

                <form action="/login" method="POST" class="login-form">
                    <div class="input-group">
                        <i class="bi bi-envelope-fill"></i>
                        <input type="email" name="email" placeholder="E-mail" required>
                    </div>

                    <div class="input-group">
                        <i class="bi bi-lock-fill"></i>
                        <input type="password" name="senha" placeholder="Senha" required>
                    </div>

                    <button type="submit" class="btn-acessar">Acessar</button>
                </form>

                <p class="auth-footer">
                    Ainda não possui conta? <a href="/cadastro">Clique para criar</a>
                </p>
            </div>

            <!-- ILUSTRAÇÃO LATERAL -->
            <div class="login-illustration">
                <img src="/IMG/Landing/gato-livro.png" alt="Gato lendo livro - The Office Papelaria">
            </div>

        </div>
    </main>

</body>

</html>