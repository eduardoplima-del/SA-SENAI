<!DOCTYPE html>
<html lang="pt-BR">

<head>
    <meta charset="UTF-8">
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>The Office Papelaria</title>

    <!-- Google Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>

    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600;700;800&display=swap"
        rel="stylesheet">

    <!-- Bootstrap Icons -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">

    <link rel="stylesheet" href="/CSS/estilos.pt.css">
</head>

<body>

    <!-- ================================= -->
    <!-- HEADER -->
    <!-- ================================= -->

    <header>

        <div class="container">

            <div class="logo">
                <a href="/">
                    <img src="/IMG/Landing/logo.png" alt="Logo">
                </a>
            </div>

            <nav>

                <ul>

                    <li><a href="/">Início</a></li>

                    <li><a href="#sobre">Sobre nós</a></li>

                    <li><a href="/catalogo">Produtos</a></li>

                </ul>

            </nav>

            <div class="header-icons">

                <a href="/catalogo" title="Buscar produtos">
                    <i class="bi bi-search"></i>
                </a>

                <% if (usuario) { %>
                    <% if (usuario.tipo==='admin' ) { %>
                        <a href="/dashboard" title="Painel Admin">
                            <i class="bi bi-person-fill"></i>
                        </a>
                        <% } else { %>
                            <a href="/pedidos/meus" title="Meus Pedidos">
                                <i class="bi bi-person-fill"></i>
                            </a>
                            <% } %>
                                <a href="/logout" title="Sair" style="font-size: 0.9rem; margin-left: 5px;">
                                    <i class="bi bi-box-arrow-right"></i>
                                </a>
                                <% } else { %>
                                    <a href="/login" title="Fazer Login">
                                        <i class="bi bi-person-fill"></i>
                                    </a>
                                    <% } %>

                                        <a href="/carrinho" title="Carrinho" style="position: relative;">
                                            <i class="bi bi-cart-fill"></i>
                                            <% if (carrinhoQtd> 0) { %>
                                                <span
                                                    style="position: absolute; top: -8px; right: -10px; background: #f1bf53; color: #000; font-size: 0.7rem; font-weight: bold; border-radius: 50%; padding: 2px 5px;">
                                                    <%= carrinhoQtd %>
                                                </span>
                                                <% } %>
                                        </a>

            </div>

        </div>

    </header>


    <!-- ================================= -->
    <!-- HERO -->
    <!-- ================================= -->

    <section class="hero">

        <div class="container hero-content">

            <div class="hero-text">

                <h1>
                    Mais que papelaria,
                    <br>
                    é o seu espaço
                    <br>
                    de ideias.
                </h1>

                <p>

                    Aqui você encontra tudo para deixar o
                    seu dia a dia mais organizado,
                    criativo e produtivo.

                </p>

                <a href="/catalogo" class="btn">

                    Ver produtos

                    <i class="bi bi-arrow-right"></i>

                </a>

            </div>

            <div class="hero-image">

                <img src="/IMG/Landing/banner-produtos.png" alt="Produtos">

            </div>

        </div>

    </section>


    <!-- ================================= -->
    <!-- BENEFÍCIOS -->
    <!-- ================================= -->

    <section class="benefits">

        <div class="container">

            <div class="benefit">

                <i class="bi bi-truck"></i>

                <div>

                    <h3>Envio rápido</h3>

                    <p>Para todo o Brasil</p>

                </div>

            </div>

            <div class="divider"></div>

            <div class="benefit">

                <i class="bi bi-heart-fill"></i>

                <div>

                    <h3>Produtos selecionados</h3>

                    <p>Qualidade e estilo</p>

                </div>

            </div>

            <div class="divider"></div>

            <div class="benefit">

                <i class="bi bi-check-circle-fill"></i>

                <div>

                    <h3>Compra segura</h3>

                    <p>Dados protegidos</p>

                </div>

            </div>

        </div>

    </section>


    <!-- ================================= -->
    <!-- SOBRE -->
    <!-- ================================= -->

    <section id="sobre" class="about">

        <div class="container about-content">

            <div class="about-text">

                <h2>Sobre nós</h2>

                <p>

                    A <strong>The Office Papelaria</strong> é uma empresa dedicada
                    a oferecer produtos de papelaria,
                    escritório e materiais escolares
                    com qualidade, praticidade e ótimo
                    custo-benefício.

                </p>

                <p>

                    Nosso objetivo é atender estudantes,
                    professores, profissionais e empresas,
                    disponibilizando uma grande variedade
                    de itens para facilitar o dia a dia
                    e estimular a criatividade.

                </p>

            </div>

            <div class="about-image">

                <img src="/IMG/Landing/gato-livro.png" alt="Gato lendo">

            </div>

        </div>

    </section>


    <!-- ================================= -->
    <!-- LOGIN -->
    <!-- ================================= -->

    <% if (!usuario) { %>
        <section class="login-section">

            <div class="container">

                <a href="/login" class="btn login-btn">

                    Fazer Login

                    <i class="bi bi-arrow-right"></i>

                </a>

            </div>

        </section>
        <% } %>


            <!-- ================================= -->
            <!-- FOOTER -->
            <!-- ================================= -->

            <footer>

                <div class="container">

                    <div class="footer-logo">

                        <img src="/IMG/Landing/logo.png" alt="The Office Papelaria">

                    </div>

                    <p>

                        © 2026 The Office Papelaria.
                        Todos os direitos reservados.

                    </p>

                </div>

            </footer>

</body>

</html>