<!DOCTYPE html>
<html lang="pt-BR">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Login - The Office Papelaria</title>
    <link rel="stylesheet" href="/CSS/login.pt.css">
</head>

<body class="auth-page">
    <div class="auth-card">
        <h2>Bem-vindo(a) de volta!</h2>
        <p>Faça seu login para continuar</p>

        <% if (erro) { %>
            <div class="alert-error">
                <%= erro %>
            </div>
            <% } %>

                <form action="/login" method="POST">
                    <div class="input-group">
                        <input type="email" name="email" placeholder="E-mail" required>
                    </div>
                    <div class="input-group">
                        <input type="password" name="senha" placeholder="Senha" required>
                    </div>
                    <button type="submit" class="btn-submit">Acessar</button>
                </form>

                <p class="auth-footer">
                    Ainda não possui conta? <a href="/cadastro">Clique para criar</a>
                </p>
    </div>
</body>

</html>