<!DOCTYPE html>
<html lang="pt-BR">

<head>
    <meta charset="UTF-8">
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>Produtos - The Office Papelaria</title>

    <!-- Google Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">

    <!-- Bootstrap Icons -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">

    <!-- Estilos das Páginas -->
    <link rel="stylesheet" href="/CSS/estilos.pt.css">
    <link rel="stylesheet" href="/CSS/produtos.pt.css">
</head>

<body>

    <!-- HEADER / NAVBAR -->
    <header>
        <div class="container">
            <div class="logo">
                <a href="/">
                    <img src="/IMG/Landing/logo.png" alt="Logo The Office Papelaria">
                </a>
            </div>

            <nav>
                <ul>
                    <li><a href="/">Início</a></li>
                    <li><a href="/#sobre">Sobre nós</a></li>
                    <li><a href="/catalogo" class="active">Produtos</a></li>
                </ul>
            </nav>

            <div class="header-icons">
                <a href="/catalogo" title="Buscar produtos">
                    <i class="bi bi-search"></i>
                </a>

                <% if (usuario) { %>
                    <% if (usuario.tipo === 'admin') { %>
                        <a href="/dashboard" title="Painel Admin">
                            <i class="bi bi-person-fill"></i>
                        </a>
                    <% } else { %>
                        <a href="/pedidos/meus" title="Meus Pedidos">
                            <i class="bi bi-person-fill"></i>
                        </a>
                    <% } %>
                    <a href="/logout" title="Sair" class="icon-logout">
                        <i class="bi bi-box-arrow-right"></i>
                    </a>
                <% } else { %>
                    <a href="/login" title="Fazer Login">
                        <i class="bi bi-person-fill"></i>
                    </a>
                <% } %>

                <a href="/carrinho" title="Carrinho" class="cart-wrapper">
                    <i class="bi bi-cart-fill"></i>
                    <% if (carrinhoQtd > 0) { %>
                        <span class="cart-badge"><%= carrinhoQtd %></span>
                    <% } %>
                </a>
            </div>
        </div>
    </header>

    <!-- CONTEÚDO PRINCIPAL DO CATÁLOGO -->
    <main class="catalogo-main">
        <div class="container">

            <% if (typeof produtosPorCategoria !== 'undefined' && Object.keys(produtosPorCategoria).length > 0) { %>
                
                <% for (let categoria in produtosPorCategoria) { %>
                    <section class="categoria-secao">
                        <h2 class="categoria-titulo"><%= categoria %></h2>
                        
                        <div class="produtos-grid">
                            <% produtosPorCategoria[categoria].forEach(produto => { %>
                                <div class="produto-card">
                                    <div class="produto-img">
                                        <img src="<%= produto.imagem_url || '/IMG/Landing/placeholder.png' %>" alt="<%= produto.nome %>">
                                    </div>
                                    <div class="produto-info">
                                        <h3><%= produto.nome %></h3>
                                        <p class="preco"><%= moeda(produto.preco) %></p>
                                        <p class="estoque"><%= produto.estoque %> disponíveis</p>
                                        <span class="status-badge <%= produto.ativo ? 'ativo' : 'inativo' %>">
                                            <%= produto.ativo ? 'ativo' : 'inativo' %>
                                        </span>
                                        
                                        <form action="/carrinho/adicionar" method="POST" class="form-add-carrinho">
                                            <input type="hidden" name="produtoId" value="<%= produto.id %>">
                                            <button type="submit" class="btn-comprar">Comprar</button>
                                        </form>
                                    </div>
                                </div>
                            <% }) %>
                        </div>
                    </section>
                <% } %>

            <% } else if (typeof produtos !== 'undefined' && produtos.length > 0) { %>

                <section class="categoria-secao">
                    <h2 class="categoria-titulo">Todos os Produtos</h2>
                    <div class="produtos-grid">
                        <% produtos.forEach(produto => { %>
                            <div class="produto-card">
                                <div class="produto-img">
                                    <img src="<%= produto.imagem_url || '/IMG/Landing/placeholder.png' %>" alt="<%= produto.nome %>">
                                </div>
                                <div class="produto-info">
                                    <h3><%= produto.nome %></h3>
                                    <p class="preco"><%= moeda(produto.preco) %></p>
                                    <p class="estoque"><%= produto.estoque %> disponíveis</p>
                                    <span class="status-badge <%= produto.ativo ? 'ativo' : 'inativo' %>">
                                        <%= produto.ativo ? 'ativo' : 'inativo' %>
                                    </span>

                                    <form action="/carrinho/adicionar" method="POST" class="form-add-carrinho">
                                        <input type="hidden" name="produtoId" value="<%= produto.id %>">
                                        <button type="submit" class="btn-comprar">Comprar</button>
                                    </form>
                                </div>
                            </div>
                        <% }) %>
                    </div>
                </section>

            <% } else { %>
                
                <!-- ESTADO VAZIO / NENHUM PRODUTO -->
                <div class="empty-state-container">
                    <div class="empty-state-card">
                        <i class="bi bi-box-seam empty-icon"></i>
                        <h2>Nenhum produto cadastrado no momento</h2>
                        <p>Estamos atualizando nosso catálogo com novos itens de papelaria. Volte em breve para conferir!</p>
                        <a href="/" class="btn-voltar-home">
                            <i class="bi bi-house-door-fill"></i> Voltar para o início
                        </a>
                    </div>
                </div>

            <% } %>

        </div>
    </main>

    <!-- FOOTER -->
    <footer>
        <div class="container">
            <div class="footer-logo">
                <img src="/IMG/Landing/logo.png" alt="The Office Papelaria">
            </div>
            <p>© 2026 The Office Papelaria. Todos os direitos reservados.</p>
        </div>
    </footer>

</body>

</html>