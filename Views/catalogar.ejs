<!DOCTYPE html>
<html lang="pt-BR">

<head>
    <meta charset="UTF-8">
    <title>Gerenciar Produtos - Papelaria</title>
    <link rel="stylesheet" href="/CSS/estilos.pt.css">
</head>

<body>
    <a href="/dashboard">&larr; Voltar ao Painel</a>
    <h2>Controle de Estoque e Produtos</h2>

    <form action="/produtos/novo" method="POST" class="form-cadastro">
        <h3>Cadastrar Produto</h3>
        <input type="text" name="nome" placeholder="Nome do Produto" required>
        <input type="number" step="0.01" name="preco" placeholder="Preço (R$)" required>
        <input type="number" name="estoque" placeholder="Quantidade em Estoque" required>
        <input type="text" name="imagem_url" placeholder="URL da Imagem">
        <button type="submit">Cadastrar Produto</button>
    </form>

    <hr>

    <h3>Produtos Cadastrados</h3>
    <table>
        <thead>
            <tr>
                <th>ID</th>
                <th>Produto</th>
                <th>Preço</th>
                <th>Estoque</th>
                <th>Status</th>
            </tr>
        </thead>
        <tbody>
            <% produtos.forEach(p=> { %>
                <tr>
                    <td>
                        <%= p.id %>
                    </td>
                    <td>
                        <%= p.nome %>
                    </td>
                    <td>
                        <%= moeda(p.preco) %>
                    </td>
                    <td>
                        <%= p.estoque %> un
                    </td>
                    <td>
                        <%= p.ativo ? 'Ativo' : 'Inativo' %>
                    </td>
                </tr>
                <% }) %>
        </tbody>
    </table>
</body>

</html>